{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-helper-remote",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL_ROOM",
        "class_name": "ControlRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ControlRoom"]
    }
  ],
  "routes": [
    {
      "pattern": "ai.soullhk.kr",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
